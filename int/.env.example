# OpenRouter API configuration
# Copy this file to .env and fill your own OpenRouter API key.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model configuration (any OpenAI-compatible model on OpenRouter)
# Recommended: google/gemini-2.5-flash (cheap + powerful, great Chinese support)
# Alternatives: anthropic/claude-haiku-4-5, deepseek/deepseek-chat-v3-0324
STAGE_PLANNER_MODEL=google/gemini-2.5-flash
REFLECTION_PLANNER_MODEL=google/gemini-2.5-flash
RESPONSE_MODEL=google/gemini-2.5-flash
GOAL_CHECKER_MODEL=google/gemini-2.5-flash

# Local configuration
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./chroma_db
MEMORY_CHROMA_DB_PATH=./memory_chroma_db
DATABASE_PATH=./sessions.db
MEMORY_UPDATE_INTERVAL=5
STORY_MIN_TURNS=20
ADMIN_KEY=change-me-before-running-admin
DISABLE_RAG=0
