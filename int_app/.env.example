# OpenRouter API configuration
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model configuration (any OpenAI-compatible model on OpenRouter)
STAGE_PLANNER_MODEL=openai/gpt-4o
REFLECTION_PLANNER_MODEL=openai/gpt-4o-mini
RESPONSE_MODEL=openai/gpt-4o
GOAL_CHECKER_MODEL=openai/gpt-4o-mini

# Local configuration
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./chroma_db
DATABASE_PATH=./sessions.db
